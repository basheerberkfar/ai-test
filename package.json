{
  "name": "ai-native-e2e-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proof of concept: AI browser agents executing E2E regression coverage from user stories.",
  "scripts": {
    "dev": "concurrently -n server,demo,lab -c blue,green,magenta \"npm:dev:server\" \"npm:dev:demo\" \"npm:dev:lab\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:demo": "vite --config apps/demo-app/vite.config.ts",
    "dev:lab": "vite --config apps/testing-workspace/vite.config.ts",
    "build": "vite build --config apps/demo-app/vite.config.ts && vite build --config apps/testing-workspace/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sut": "tsx scripts/sut.ts",
    "smoke": "tsx scripts/smoke-browser.ts",
    "ci": "tsx scripts/ci.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "evaluate": "tsx scripts/evaluate.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.63.0",
    "openai": "^7.45.1",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
