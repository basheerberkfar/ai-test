# --- AI provider -------------------------------------------------------------
# anthropic | openai
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model routing lives in config/ai-testing.json (economy vs advanced tier per role).
# Optional overrides:
#   AI_MODEL=            one model for every role (disables routing)
#   AI_MODEL_ECONOMY=    e.g. claude-sonnet-5-5
#   AI_MODEL_ADVANCED=   e.g. claude-opus-5-5
# Reasoning effort for Anthropic models (low | medium | high | xhigh | max)
AI_EFFORT=medium
# Server-side refusal fallback for Anthropic (set to "off" to disable)
ANTHROPIC_FALLBACKS=default

# --- Cost / limits -----------------------------------------------------------
# Limits per execution mode are in config/ai-testing.json. This is a hard cap that
# no run may exceed, whatever the mode says (CI sets it to the job budget).
# AI_MAX_COST_USD=5

# --- Browser ------------------------------------------------------------------
# Path to Chrome/Chromium/Edge. Auto-detected on Windows/macOS/Linux when empty.
CHROME_PATH=
# true = headless, false = visible browser window during runs
BROWSER_HEADLESS=true

# --- Authorized test accounts (seeded demo data, not real secrets) ------------
TEST_THERAPIST_EMAIL=therapist@demo.clinic
TEST_THERAPIST_PASSWORD=Therapist#2024
TEST_ADMIN_EMAIL=admin@demo.clinic
TEST_ADMIN_PASSWORD=Admin#2024

# --- Isolation (used by CI) ---------------------------------------------------
# AI_TEST_DATA_DIR=     databases (default ./data)
# AI_TEST_OUTPUT_DIR=   reports/ and artifacts/ (default project root)

SERVER_PORT=4000
